# Server Configuration
PORT=3001
NODE_ENV=development

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Admin Email (where appointment notifications are sent)
ADMIN_EMAIL=admin@crystalcabin.com

# Supabase (appointment storage)
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Panel Security
# Password used to log in at /admin (choose something strong)
ADMIN_PASSWORD=change-me-strong-password
# Random secret used to sign admin session tokens (e.g. output of: openssl rand -base64 48)
ADMIN_TOKEN_SECRET=replace-with-random-secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173